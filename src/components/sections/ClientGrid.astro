---
// Clients page: a compact grid led by the client's name
import { Image } from 'astro:assets';
import Wrapper from '../../layouts/Wrapper.astro';
import type { WorkItem } from '../../utils/workUtils';

interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;

const medium = (type: string) =>
  type
    .split(', ')
    .map(
      (t) =>
        ({
          stills: 'Photography',
          moving: 'Video',
          installation: 'Live visuals',
        })[t] ?? t,
    )
    .join(' & ');
---

<section class="clients">
  <Wrapper>
    <ul class="grid">
      {
        items.map((item) => (
          <li data-reveal>
            <a href={item.url} class="card">
              <div class="media">
                {item.thumbnail && (
                  <Image
                    src={item.thumbnail}
                    alt=""
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw"
                    format="webp"
                    loading="lazy"
                  />
                )}
              </div>
              <p class="client meta">{item.location}</p>
              <h2 class="title title-font-bold">{item.title}</h2>
              <p class="details meta">
                {medium(item.type)} · {item.years}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-2xl) var(--space-m);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    display: grid;
    gap: var(--space-2xs);
  }

  .media {
    overflow: hidden;
    margin-bottom: var(--space-2xs);
    background-color: var(--color-placeholder);
    aspect-ratio: 16 / 9;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .client {
    color: var(--color-accent);
  }

  .title {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    transition: color 0.2s ease;
  }

  .details {
    color: var(--color-muted);
  }

  .card:hover .title,
  .card:focus-visible .title {
    color: var(--color-accent);
  }

  .card:hover .media :global(img) {
    transform: scale(1.02);
  }
</style>
