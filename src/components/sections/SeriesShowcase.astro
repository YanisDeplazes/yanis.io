---
// Series page: each series as a big title with a strip of three frames
import { Image } from 'astro:assets';
import Wrapper from '../../layouts/Wrapper.astro';
import { isImage, toListItem, type WorkEntry } from '../../utils/workUtils';
import { resolveImage } from '../../utils/media';

interface Props {
  entries: WorkEntry[];
}

const { entries } = Astro.props;

const series = await Promise.all(
  entries.map(async (entry) => {
    const item = await toListItem(entry);
    // The cover, then the first two other photographs of the gallery
    const extra =
      entry.data.preview ??
      entry.data.gallery
        .filter(isImage)
        .map((block) => block.image)
        .filter((path) => path !== entry.data.thumbnail)
        .slice(0, 2);
    const frames = (
      await Promise.all([entry.data.thumbnail, ...extra].map((path) => resolveImage(path)))
    ).filter((image): image is ImageMetadata => Boolean(image));
    return { item, frames };
  }),
);
---

<section class="series-list">
  <Wrapper>
    <ol>
      {
        series.map(({ item, frames }, i) => (
          <li data-reveal>
            <a href={item.url} class="series">
              <div class="head">
                <h2 class="title title-font-bold">{item.title}</h2>
                <p class="details meta">
                  <span>{item.years}</span>
                  {item.location && <span>{item.location}</span>}
                </p>
                <p class="description">{item.description}</p>
              </div>

              <div class="strip" data-count={frames.length}>
                {frames.map((image, f) => (
                  <div class="frame">
                    <Image
                      src={image}
                      alt=""
                      widths={f === 0 ? [800, 1200, 1800] : [400, 700]}
                      sizes={f === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
                      format="webp"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </Wrapper>
</section>

<style>
  ol {
    display: grid;
    gap: var(--space-4xl);
  }

  .series {
    display: grid;
    gap: var(--space-m);
  }

  .head {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-line);
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    color: var(--color-muted);
  }

  .title {
    font-size: clamp(2rem, 1rem + 3.2vw, 4rem);
    text-wrap: balance;
    transition: color 0.2s ease;
  }

  .description {
    max-width: 46ch;
    line-height: 1.5;
  }

  .strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }

  .frame {
    overflow: hidden;
    background-color: var(--color-placeholder);
    aspect-ratio: 2 / 3;
  }

  .frame:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 3 / 2;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .series:hover .title,
  .series:focus-visible .title {
    color: var(--color-accent);
  }

  .series:hover .frame :global(img) {
    transform: scale(1.02);
  }

  @media (min-width: 900px) {
    /* Title and dateline on the left, the description on the right, bottoms aligned */
    .head {
      grid-template-columns: 7fr 5fr;
      grid-template-rows: auto auto;
      column-gap: var(--space-m);
      row-gap: var(--space-xs);
      align-items: end;
    }

    .title {
      grid-column: 1;
      grid-row: 1;
    }

    .details {
      grid-column: 1;
      grid-row: 2;
    }

    .description {
      grid-column: 2;
      grid-row: 1 / 3;
      justify-self: end;
    }

    /* Cover twice as wide as the two frames beside it, all the same height */
    .strip {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-s);
    }

    .frame:first-child {
      grid-column: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
