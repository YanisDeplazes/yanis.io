---
import { Image, getImage } from 'astro:assets';
import type { WorkItem } from '../../utils/workUtils';

interface Props {
  item: WorkItem & { thumbnail: ImageMetadata };
}

const { item } = Astro.props;

// Small copy for the photo that follows the cursor in the index view (HoverPreview)
const preview = await getImage({ src: item.thumbnail, width: 560, format: 'webp' });

// "Reportage · Groundswell" for a story that belongs to a collection
const category = [item.categoryLabel, item.seriesTitle].filter(Boolean).join(' · ');

const details = [
  { label: 'Category', value: category },
  { label: 'Type', value: item.type },
  { label: 'Location', value: item.location || '—' },
  { label: 'Year', value: item.years },
];
---

<!--
  One entry, two layouts, switched by data-view on .archive:
  - grid:  image, title, category · year
  - index: title and details in table columns
-->
<a href={`/work/${item.slug}`} class="entry" data-hover-preview={preview.src}>
  <div class="media">
    <Image
      src={item.thumbnail}
      alt=""
      widths={[400, 800, 1200]}
      sizes="(min-width: 1000px) 25vw, (min-width: 600px) 50vw, 100vw"
      format="webp"
      loading="lazy"
    />
  </div>

  <h2 class="title title-font-bold">{item.title}</h2>

  <p class="summary meta">{category} · {item.years}</p>

  <dl class="details">
    {
      details.map(({ label, value }) => (
        <div class="detail">
          <dt class="meta">{label}</dt>
          <dd class="meta">{value}</dd>
        </div>
      ))
    }
  </dl>
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .title {
    font-size: 1.0625rem;
    line-height: 1.1;
    text-wrap: balance;
    transition: color 0.2s ease;
  }

  .summary {
    color: var(--color-muted);
  }

  .details {
    display: none;
  }

  /* ---------- Grid ---------- */
  .media {
    aspect-ratio: 3 / 2;
    margin-bottom: var(--space-2xs);
    overflow: hidden;
    background-color: var(--color-placeholder);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .entry:hover .title,
  .entry:focus-visible .title {
    color: var(--color-accent);
  }

  .entry:hover .media :global(img) {
    transform: scale(1.03);
  }

  /* ---------- Index ---------- */
  :global(.archive[data-view='index']) .entry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xs) var(--space-m);
    align-items: baseline;
    padding: var(--space-xs) var(--space-2xs);
    transition: background-color 0.2s ease;
  }

  :global(.archive[data-view='index']) .entry:hover {
    background-color: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  :global(.archive[data-view='index']) .media,
  :global(.archive[data-view='index']) .summary {
    display: none;
  }

  :global(.archive[data-view='index']) .title {
    grid-column: 1 / -1;
  }

  /* Each detail becomes its own column */
  :global(.archive[data-view='index']) .details {
    display: contents;
  }

  :global(.archive[data-view='index']) .detail {
    min-width: 0;
  }

  :global(.archive[data-view='index']) dt {
    margin-bottom: 2px;
    color: var(--color-muted);
  }

  :global(.archive[data-view='index']) dd {
    overflow-wrap: anywhere;
  }

  @media (min-width: 1000px) {
    :global(.archive[data-view='index']) .entry {
      grid-template-columns: var(--archive-columns);
    }

    :global(.archive[data-view='index']) .title {
      grid-column: auto;
    }

    :global(.archive[data-view='index']) dt {
      display: none;
    }

    :global(.archive[data-view='index']) .detail:nth-child(n + 3) {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .media :global(img) {
      transition: none;
    }
  }
</style>
