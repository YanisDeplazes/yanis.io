---
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  /** Chapter title and dateline, added to the caption in the lightbox */
  context?: string;
  number?: string;
  /** Silent loop that plays like a moving photograph, without controls */
  autoplay?: boolean;
}

const { src, poster, caption, context, number, autoplay = false } = Astro.props;

const label = caption?.replace(/<[^>]+>/g, '');
// Plain text for the lightbox, same as photographs
const lightboxCaption = [context, label].filter(Boolean).join(' — ');

// Everything the lightbox needs to play it large (see Lightbox.astro)
const lightbox = {
  'data-lightbox': true,
  'data-type': 'video',
  'data-full': src,
  'data-poster': poster,
  'data-loop': String(autoplay),
  'data-alt': label,
  'data-caption': lightboxCaption,
};
---

<figure class="video">
  <div class="player">
    {
      autoplay ? (
        // A loop is a moving photograph: the whole frame opens it large, like an image
        <button
          type="button"
          class="open"
          aria-label={`View video${number ? ` ${number}` : ''} full screen`}
          {...lightbox}
        >
          <video
            src={src}
            poster={poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={label}
          />
        </button>
      ) : (
        <>
          <video
            src={src}
            poster={poster}
            controls
            playsinline
            preload="none"
            aria-label={label}
          />
          {/* The player keeps its own controls; this corner button opens it large */}
          <button
            type="button"
            class="expand meta"
            aria-label={`View video${number ? ` ${number}` : ''} full screen`}
            {...lightbox}
          >
            ⤢
          </button>
        </>
      )
    }
  </div>

  {
    (number || caption) && (
      <figcaption class="caption">
        {number && <span class="number">{number}</span>}
        {caption && <span class="text" set:html={caption} />}
      </figcaption>
    )
  }
</figure>

<style>
  .video {
    width: min(100%, 1320px);
  }

  .player {
    position: relative;
  }

  .open {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }

  video {
    display: block;
    width: 100%;
    max-height: 85svh;
    object-fit: contain;
    background-color: var(--color-placeholder);
  }

  .expand {
    position: absolute;
    top: var(--space-2xs);
    right: var(--space-2xs);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1rem;
    background-color: var(--color-paper);
    color: var(--color-ink);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
  }

  /* Visible when the player is hovered or the button has keyboard focus; always on touch screens */
  .player:hover .expand,
  .expand:focus-visible {
    opacity: 1;
  }

  .expand:hover {
    color: var(--color-accent);
  }

  @media (hover: none) {
    .expand {
      opacity: 1;
    }
  }

  /* Contact sheet: the whole tile opens the lightbox */
  :global(.gallery[data-layout='sheet']) .expand {
    inset: 0;
    width: auto;
    height: auto;
    opacity: 0;
  }

  .caption {
    display: flex;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
    color: var(--color-muted);
  }

  .number {
    flex-shrink: 0;
    color: var(--color-ink);
  }
</style>
