---
// Old addresses (/work/<slug>, and slugs listed under `redirectFrom`) forward to the new ones
import { getPublished, urlFor } from '../../utils/workUtils';

export async function getStaticPaths() {
  const entries = await getPublished();
  return entries.flatMap((entry) =>
    [entry.id, ...(entry.data.redirectFrom ?? [])].map((slug) => ({
      params: { slug },
      props: { to: urlFor(entry) },
    })),
  );
}

return Astro.redirect(Astro.props.to, 301);
---
