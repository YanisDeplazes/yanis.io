---
// A titled list of project cards, used by the Photography and Research pages
import Wrapper from '../../layouts/Wrapper.astro';
import ReportageWrapper from '../wrappers/ReportageWrapper.astro';
import type { WorkItem } from '../../utils/workUtils';

interface Props {
  heading: string;
  items: WorkItem[];
  more?: string;
  showSeries?: boolean;
}

const { heading, items, more, showSeries = false } = Astro.props;
const id = `list-${heading.toLowerCase().replace(/[^a-z]+/g, '-')}`;
---

{
  items.length > 0 && (
    <section class="listing" aria-labelledby={id}>
      <Wrapper>
        <h2 id={id} class="section-label meta">
          {heading} <span class="count">{items.length}</span>
        </h2>
        <ol class="items">
          {items.map((item) => (
            <li data-reveal>
              <ReportageWrapper
                item={item}
                series={showSeries ? item.seriesTitle : undefined}
                more={more}
              />
            </li>
          ))}
        </ol>
      </Wrapper>
    </section>
  )
}

<style>
  .listing + .listing {
    margin-top: var(--space-4xl);
  }

  .section-label {
    display: flex;
    gap: var(--space-2xs);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  .count {
    color: var(--color-muted);
  }

  .items {
    display: grid;
    gap: var(--space-3xl);
  }
</style>
