---
// Title block for the listing pages (Archive, Reportage, Info)
import Wrapper from '../../layouts/Wrapper.astro';

interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="page-header">
  <Wrapper>
    <h1 class="title title-font-bold">{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </Wrapper>
</header>

<style>
  .page-header {
    padding-block: var(--space-2xl) var(--gap-block);
  }

  .title {
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5.5rem);
  }

  .intro {
    max-width: 44ch;
    margin-top: var(--gap-inside);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.35;
    color: var(--color-muted);
  }
</style>
