---
// Top of a project page: back link, title, the text from the content file, and the facts.
import Wrapper from '../../layouts/Wrapper.astro';
import List from './List.astro';

interface Fact {
  label: string;
  value?: string;
  items?: string[];
}

interface Props {
  title: string;
  category: string;
  back: { href: string; label: string };
  facts: Fact[];
}

const { title, category, back, facts } = Astro.props;
---

<header class="project-header">
  <Wrapper>
    <nav class="crumbs meta" aria-label="Breadcrumb">
      <a href={back.href}>{back.label}</a>
      <span aria-hidden="true">/</span>
      <span>{category}</span>
    </nav>

    <h1 class="title title-font-bold" set:html={title} />

    <div class="columns">
      <div class="prose">
        <slot />
      </div>

      <dl class="facts">
        {
          facts.map((fact) =>
            fact.items ? (
              <List label={fact.label} items={fact.items} />
            ) : (
              <List label={fact.label}>{fact.value}</List>
            ),
          )
        }
      </dl>
    </div>
  </Wrapper>
</header>

<style>
  .project-header {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
  }

  .crumbs {
    display: flex;
    gap: var(--space-2xs);
    color: var(--color-muted);
  }

  .crumbs a {
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .crumbs a:hover {
    color: var(--color-accent);
  }

  .title {
    max-width: 18ch;
    margin-top: var(--space-s);
    font-size: clamp(2rem, 1.2rem + 3.3vw, 4.25rem);
    text-wrap: balance;
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .facts {
    align-self: start;
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 1000px) {
    .columns {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-m);
    }

    .prose {
      grid-column: 1 / 7;
    }

    .facts {
      grid-column: 8 / -1;
    }
  }
</style>
