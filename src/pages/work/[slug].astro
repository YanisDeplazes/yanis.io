---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Description from '../../components/sections/Description.astro';
import Gallery from '../../components/sections/Gallery.astro';
import Lightbox from '../../components/sections/Lightbox.astro';
import ProjectNav from '../../components/sections/ProjectNav.astro';
import SeriesStories, { type SeriesStory } from '../../components/sections/SeriesStories.astro';
import { getCategoryLabel, getPublished, getWork, isImage, toListItem } from '../../utils/workUtils';
import type { WorkEntry } from '../../utils/workUtils';
import { resolveImage } from '../../utils/media';
import { escapeHtml, formatDate, formatDateline, formatList, formatYears } from '../../utils/format';
import { breadcrumbSchema, projectSchema } from '../../utils/seo';
import { getPublications } from '../../data/profile';

// Every project gets a page except drafts (hidden ones too, reachable by link)
export async function getStaticPaths() {
  const entries = await getPublished();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { data } = entry;
// Fallbacks for entries cached before these fields existed (see UPGRADE.md: astro dev --force)
const gallery = data.gallery ?? [];
const links = data.links ?? [];
const lists = data.lists ?? [];
const { Content } = await render(entry);

const thumbnail = await resolveImage(data.thumbnail);
const category = getCategoryLabel(data.category);
const location = formatList(data.location);
const path = `/work/${entry.id}`;

// Reportage pages lead back to the reportage listing, everything else to the archive
const isReportage = data.category === 'reportage';
const back = isReportage
  ? { href: '/reportage', label: 'Reportage' }
  : { href: '/work', label: 'Archive' };

const link = (href: string, label: string) =>
  `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer">${escapeHtml(label)}</a>`;

// Articles sit on the story they belong to, not on a collection like Groundswell
const isCollection = data.category === 'collection';
const published = (isCollection ? [] : getPublications(entry.id)).map(
  ({ outlet, href, date }) =>
    `${link(href, outlet)}${date ? `, ${formatDate(new Date(date))}` : ''}`,
);

// A collection lists the stories filed under it (see `series` in content.config.ts)
const photosOf = async (story: WorkEntry, limit?: number) => {
  const paths = (story.data.gallery ?? []).filter(isImage).map((block) => block.image);
  const images = await Promise.all(paths.slice(0, limit).map((path) => resolveImage(path)));
  return images.filter((image): image is ImageMetadata => Boolean(image));
};

const stories: SeriesStory[] = await Promise.all(
  (await getWork((d) => d.series === entry.id)).map(async (story) => ({
    slug: story.id,
    title: story.data.title,
    description: story.data.description,
    start: story.data.start,
    date: story.data.category === 'reportage' ? formatDateline(story.data) : formatYears(story.data),
    location: formatList(story.data.location),
    thumbnail: await resolveImage(story.data.thumbnail),
    count: (story.data.gallery ?? []).filter(isImage).length,
  })),
);

// …and a story points back to its collection
const series = data.series ? (await getPublished()).find((e) => e.id === data.series) : undefined;

interface Fact {
  label: string;
  value?: string;
  items?: string[];
}

const facts: Fact[] = [
  { label: isReportage ? 'Date' : 'Year', value: isReportage ? formatDateline(data) : formatYears(data) },
  { label: 'Location', value: location },
  {
    label: 'Series',
    items: series ? [`<a href="/work/${series.id}">${escapeHtml(series.data.title)}</a>`] : [],
  },
  { label: 'Client', value: data.client },
  { label: 'Made at', value: data.institution },
  { label: 'Type', value: (data.type ?? []).join(', ') },
  { label: 'Links', items: links.map(({ href, label }) => link(href, label)) },
  { label: 'Published in', items: published },
  ...lists.map((list) => ({ label: list.title, items: list.items })),
].filter((fact) => (fact.items ? fact.items.length > 0 : Boolean(fact.value)));

// Next project in the same listing (wraps around at the end)
const siblings = await getWork((d) => (d.category === 'reportage') === isReportage);
const index = siblings.findIndex((sibling) => sibling.id === entry.id);
const nextEntry =
  index !== -1 && siblings.length > 1 ? siblings[(index + 1) % siblings.length] : undefined;
const next = nextEntry ? await toListItem(nextEntry) : undefined;

// Search engines: the thumbnail plus the first few photographs (a collection: its stories' first)
const photos = await photosOf(entry, 4);
const schemaImages = [thumbnail, ...photos]
  .filter((image): image is ImageMetadata => Boolean(image))
  .map((image) => image.src);

const schema = [
  projectSchema({
    title: data.title,
    description: data.description,
    path,
    isNews: isReportage,
    start: data.start,
    end: data.end,
    location,
    category,
    images: [...new Set(schemaImages)],
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: back.label, path: back.href },
    { name: data.title, path },
  ]),
];
---

<Layout
  title={data.title}
  description={data.description}
  image={thumbnail?.src}
  imageAlt={`${data.title}, ${category.toLowerCase()} by Yanis Deplazes`}
  type="article"
  published={data.start}
  modified={data.end}
  noindex={data.hidden}
  schema={schema}
>
  <article>
    <Description title={data.title} category={category} back={back} facts={facts}>
      <Content />
    </Description>

    {gallery.length > 0 && <Gallery blocks={gallery} title={data.title} layout={data.layout} />}

    {stories.length > 0 && <SeriesStories stories={stories} heading={data.storiesHeading} />}

    <ProjectNav next={next} back={back} />
  </article>

  <Lightbox />
</Layout>
