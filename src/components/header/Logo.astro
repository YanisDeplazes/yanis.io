---
import { profile } from '../../data/profile';

const { label } = profile.location;
---

<div class="identity">
  <a href="/" class="logo title-font-bold" aria-label={`${profile.name}, home`}>
    {profile.name}
  </a>

  <p class="details meta">
    <span class="tagline">{profile.tagline}</span>
    <span class="where">{label}</span>
  </p>
</div>

<style>
  .identity {
    position: relative;
    z-index: 2; /* stays above the open mobile menu */
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-width: 0;
  }

  .logo {
    font-size: 1.125rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .details {
    flex-direction: column;
    color: var(--color-muted);
    line-height: 1.35;
    white-space: nowrap;
  }

  .details,
  .tagline {
    display: none;
  }

  @media (min-width: 600px) {
    .details {
      display: flex;
    }
  }

  @media (min-width: 1100px) {
    .tagline {
      display: inline;
    }
  }
</style>
