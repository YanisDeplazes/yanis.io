---
interface Props {
  /** Filter values in display order, without "all" */
  categories: string[];
  /** Button label per value, including "all" */
  labels: Record<string, string>;
  /** Number of entries per value, including "all" */
  counts: Record<string, number>;
}

const { categories, labels, counts } = Astro.props;
const filters = ['all', ...categories];
---

<div class="filter-sentinel" aria-hidden="true"></div>

<nav class="filter-bar" aria-label="Filter work">
  <ul class="filters">
    {
      filters.map((filter) => (
        <li>
          <button
            type="button"
            class="filter-btn mark-link"
            data-filter={filter}
            aria-pressed={filter === 'all' ? 'true' : 'false'}
          >
            {labels[filter] ?? filter}
            <sup class="count meta">{counts[filter] ?? 0}</sup>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="view-toggle meta" role="group" aria-label="View">
    <button type="button" class="mark-link" data-view="grid" aria-pressed="true"
      >Grid</button
    >
    <button
      type="button"
      class="mark-link"
      data-view="index"
      aria-pressed="false">Index</button
    >
  </div>
</nav>

<style>
  /* Marks the bar's resting position; once it scrolls away the bar is stuck */
  .filter-sentinel {
    height: 1px;
    margin-bottom: -1px;
  }

  .filter-bar {
    position: sticky;
    top: calc(var(--header-height) - 1px);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 3.5rem;
    margin-bottom: var(--gap-block);
    background-color: var(--color-paper);
    border-block: 1px solid var(--color-line);
  }

  .filters {
    display: flex;
    gap: var(--space-m);

    /* Scrolls sideways on small screens instead of wrapping */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    padding-block: var(--space-2xs);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .filter-btn:hover {
    color: var(--color-ink);
  }

  /* inline-block keeps the count out of the underline */
  .count {
    display: inline-block;
    margin-left: 0.3em;
    font-size: 0.6875rem;
    vertical-align: 0.5em;
    line-height: 0;
  }

  .view-toggle {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-s);
  }

  .view-toggle button {
    color: var(--color-muted);
  }

  .view-toggle button:hover {
    color: var(--color-ink);
  }
</style>
