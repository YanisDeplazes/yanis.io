---
import { Image } from 'astro:assets';
import type { WorkItem } from '../../utils/workUtils';
import { padNumber } from '../../utils/format';

interface Props {
  item: WorkItem & { thumbnail: ImageMetadata };
  number: number;
  total: number;
  /** Responsive image sizes for the slot this feature sits in */
  sizes: string;
}

const { item, number, total, sizes } = Astro.props;
---

<a href={`/work/${item.slug}`} class="feature">
  <div class="media" style={`--ratio: ${item.thumbnail.width / item.thumbnail.height}`}>
    <Image
      src={item.thumbnail}
      alt=""
      widths={[640, 960, 1280, 1920, 2560]}
      sizes={sizes}
      format="webp"
      loading={number === 1 ? 'eager' : 'lazy'}
    />
  </div>

  <div class="caption-row">
    <span class="number meta">{padNumber(number, total)}</span>
    <div class="text">
      <h3 class="title title-font-bold">{item.title}</h3>
      <p class="details meta">{item.categoryLabel} · {item.years}</p>
      {item.description && <p class="description">{item.description}</p>}
    </div>
  </div>
</a>

<style>
  .feature {
    display: block;
  }

  .media {
    overflow: hidden;
    background-color: var(--color-placeholder);
  }

  /* Photos are shown whole, at their own aspect ratio */
  .media :global(img) {
    width: 100%;
    height: auto;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .caption-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3xs) var(--space-xs);
    padding-top: var(--space-xs);
  }

  .number {
    padding-top: 0.2em;
    color: var(--color-muted);
  }

  .title {
    font-size: 1.125rem;
    line-height: 1.1;
    transition: color 0.2s ease;
  }

  .details {
    margin-top: 0.35em;
    color: var(--color-muted);
  }

  .description {
    max-width: 48ch;
    margin-top: 0.5em;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .feature:hover .title,
  .feature:focus-visible .title {
    color: var(--color-accent);
  }

  .feature:hover .media :global(img) {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .media :global(img) {
      transition: none;
    }
  }
</style>
