---
import Wrapper from './Wrapper.astro';
import Logo from '../components/header/Logo.astro';
import Navigation from '../components/header/Navigation.astro';
---

<header class="site-header">
  <Wrapper>
    <div class="bar">
      <Logo />
      <Navigation />
    </div>
  </Wrapper>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  /* A hairline appears once the page scrolls under the header */
  .site-header.is-scrolled {
    border-bottom-color: var(--color-line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 72px;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header) {
    // Expose the header height so sticky elements (filters, gallery toolbar) sit right below it
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    setHeight();
    new ResizeObserver(setHeight).observe(header);

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
