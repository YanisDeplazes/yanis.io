<button
  type="button"
  class="menu-toggle meta"
  aria-expanded="false"
  aria-controls="site-menu"
>
  <span class="open-label">Menu</span>
  <span class="close-label">Close</span>
</button>

<style>
  .menu-toggle {
    position: relative;
    z-index: 2; /* stays above the open menu */
    padding: var(--space-2xs) 0;
  }

  .close-label,
  .menu-toggle[aria-expanded='true'] .open-label {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .close-label {
    display: inline;
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }
  }
</style>
