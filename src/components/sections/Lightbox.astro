---
// Full-screen viewer for photos and videos marked with [data-lightbox]
// (see ImageWrapper and VideoWrapper). Uses a native <dialog>: focus handling and Escape come for free.
// Videos: a loop plays silently on repeat, like on the page; any other video plays with controls and sound.
---

<dialog class="lightbox" aria-label="Media viewer">
  <div class="top meta">
    <button type="button" data-action="close">Close ✕</button>
  </div>

  <div class="stage">
    <img class="lightbox-media lightbox-image" alt="" hidden />
    <video class="lightbox-media lightbox-video" playsinline hidden></video>
  </div>

  <div class="bar">
    <p class="counter meta" aria-live="polite"></p>
    <p class="lightbox-caption caption"></p>
    <div class="controls meta">
      <button type="button" data-action="prev" aria-label="Previous">←</button>
      <button type="button" data-action="next" aria-label="Next">→</button>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .lightbox::backdrop {
    background-color: var(--color-paper);
  }

  /* Close sits top right, where people look for it */
  .top {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-s) var(--padding-side) 0;
  }

  .top button {
    transition: color 0.2s ease;
  }

  .top button:hover {
    color: var(--color-accent);
  }

  /* The stage takes all the height the bars leave.
     Photo or video fills it and is fitted inside, whole, at any window size
     (percentages of a grid row's height don't resolve, so it is positioned instead). */
  .stage {
    position: relative;
    min-height: 0;
  }

  .lightbox-media {
    position: absolute;
    top: var(--space-s);
    left: var(--padding-side);
    width: calc(100% - 2 * var(--padding-side));
    height: calc(100% - var(--space-s));
    max-width: none;
    max-height: none;
    object-fit: contain;
  }

  .lightbox-media[hidden] {
    display: none;
  }

  .bar {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: var(--space-s);
    align-items: baseline;
    padding: var(--space-s) var(--padding-side);
  }

  .counter {
    color: var(--color-muted);
  }

  .lightbox-caption {
    color: var(--color-muted);
  }

  .controls {
    display: flex;
    gap: var(--space-s);
  }

  .controls button {
    transition: color 0.2s ease;
  }

  .controls button:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .bar {
      grid-template-columns: 1fr auto;
    }

    .lightbox-caption {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const triggers = [
    ...document.querySelectorAll<HTMLElement>('[data-lightbox]'),
  ];

  if (dialog && triggers.length) {
    const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
    const video = dialog.querySelector<HTMLVideoElement>('.lightbox-video')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
    const counter = dialog.querySelector<HTMLElement>('.counter')!;
    let current = 0;

    // Stop and unload the video, so it doesn't keep playing or downloading in the background
    const stopVideo = () => {
      video.pause();
      video.removeAttribute('src');
      video.removeAttribute('poster');
      video.load();
      video.hidden = true;
    };

    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const {
        type,
        full = '',
        poster,
        loop,
        alt = '',
        caption: text = '',
      } = triggers[current].dataset;

      stopVideo();
      image.hidden = true;

      if (type === 'video') {
        const isLoop = loop === 'true';
        // A loop stays a silent moving photograph; anything else gets controls and sound
        video.loop = isLoop;
        video.muted = isLoop;
        video.controls = !isLoop;
        if (poster) video.poster = poster;
        video.src = full;
        video.setAttribute('aria-label', alt);
        video.hidden = false;
        // Opened by a click, so the browser allows sound; fall back to muted if it still refuses
        video.play().catch(() => {
          video.muted = true;
          video.play().catch(() => {});
        });
      } else {
        image.src = full;
        image.alt = alt;
        image.hidden = false;
      }

      caption.textContent = text;
      counter.textContent = `${current + 1} / ${triggers.length}`;
    };

    const open = (index: number) => {
      show(index);
      dialog.showModal();
      document.documentElement.classList.add('is-locked');
    };

    triggers.forEach((trigger, index) =>
      trigger.addEventListener('click', () => open(index)),
    );

    dialog.addEventListener('close', () => {
      stopVideo();
      document.documentElement.classList.remove('is-locked');
      triggers[current].focus();
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const action =
        target.closest<HTMLElement>('[data-action]')?.dataset.action;

      if (action === 'prev') show(current - 1);
      else if (action === 'next') show(current + 1);
      else if (action === 'close' || target.classList.contains('stage'))
        dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      // Arrow keys on a focused video player seek; leave them to the player
      if (event.target === video) return;
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Swipe on touch screens (not while scrubbing the video's timeline)
    let touchStartX = 0;
    let touchOnControls = false;
    dialog.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0].clientX;
        touchOnControls = event.target === video && video.controls;
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchend',
      (event) => {
        if (touchOnControls) return;
        const distance = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
