---
// One row of facts on a project page: a label and its value(s).
// Pass `items` for HTML strings from content files, or use the slot.
interface Props {
  label: string;
  items?: string[];
}

const { label, items } = Astro.props;
---

<div class="fact">
  <dt class="meta">{label}</dt>
  <dd>
    {
      items ? (
        <ul>
          {items.map((html) => (
            <li set:html={html} />
          ))}
        </ul>
      ) : (
        <slot />
      )
    }
  </dd>
</div>

<style>
  .fact {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-xs);
    padding-block: var(--space-2xs);
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  dt {
    padding-top: 0.2em;
    color: var(--color-muted);
  }

  ul {
    display: grid;
    gap: 0.2em;
  }

  dd :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 0.2s ease;
  }

  dd :global(a:hover) {
    color: var(--color-accent);
  }
</style>
