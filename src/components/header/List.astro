---
const links = [
  { name: 'selected', path: '/' },
  { name: 'reportage', path: '/reportage' },
  { name: 'archive', path: '/work' },
  { name: 'info', path: '/info' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<ul class="list" id="site-menu">
  {
    links.map(({ name, path }) => (
      <li>
        <a href={path} class="link mark-link" aria-current={isActive(path) ? 'page' : undefined}>
          {name}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* ----- Mobile: full-screen menu ----- */
  .list {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xs);
    padding-inline: var(--padding-side);
    background-color: var(--color-accent);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 12vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s;
  }

  /* On the orange menu the current page is underlined in ink */
  .list .link[aria-current='page'] {
    text-decoration-color: var(--color-ink);
  }

  :global(.navigation[data-open='true']) .list {
    opacity: 1;
    visibility: visible;
  }

  /* ----- Desktop: one quiet line ----- */
  @media (min-width: 900px) {
    .list {
      position: static;
      flex-direction: row;
      gap: var(--space-m);
      padding: 0;
      background: none;
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.5;
      text-transform: none;
      opacity: 1;
      visibility: visible;
    }

    .list .link {
      color: var(--color-muted);
    }

    .list .link:hover {
      color: var(--color-ink);
    }

    .list .link[aria-current='page'] {
      color: var(--color-ink);
      text-decoration-color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .list {
      transition: none;
    }
  }
</style>
