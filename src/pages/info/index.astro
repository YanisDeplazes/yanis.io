---
import Layout from '../../layouts/Layout.astro';
import Image from '../../assets/images/portrait.jpg';
import Description from '../../components/sections/Description.astro';
import ImageWrapper from '../../components/wrappers/ImageWrapper.astro';
import List from '../../components/sections/List.astro';

const title = 'Info';
const suffix = 'Yanis Deplazes';
const description =
  'Yanis Deplazes is a visual journalist and researcher based between Switzerland and the Netherlands. Exploring people and society through multimedia.';

const thumbnail = Image.src;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp}',
);

const resolveImage = async (url: string) => images[`/src/assets${url}`]?.();

let resolvedThumbnail;

if (thumbnail) {
  const resolved = await resolveImage(thumbnail);
  resolvedThumbnail = resolved?.default; // Use the URL string directly
}
---

<Layout
  title={`${title} — ${suffix}`}
  description={description}
  imageSrc={Image.src}
>
  <Description title="Info">
    <div slot="additional">
      <p>
        <b>Yanis Deplazes</b> is a visual journalist and researcher based between
        Switzerland and the Netherlands. Their work explores people and society through
        multimedia. They came to photography in 2020 from a background in computer
        science, and since 2023 they have combined analog and digital techniques
        in their practice.
      </p>
      <p>
        Social movements and collective struggles across Europe are at the core
        of their work, especially in the Netherlands, Belgium and Switzerland.
        Alongside reportage, they build experimental apparatus that examine
        social structures and everyday life.
      </p>
      <p>
        They are currently pursuing an MA in Information Design at Design
        Academy Eindhoven, bringing their practice into a research and design
        context.
      </p>
      <p>
        Photojournalist and member of
        <a href="https://hanslucas.com/" target="_blank">Hans Lucas</a>, through
        which their work is distributed on Reuters, AFP, dpa, Belga, Forum
        Polska Agencja Fotografów and PixPalace. Available for freelance
        assignments and commissions worldwide.
      </p>
      <List title="Member">
        <li>
          <a href="https://poolcollective.ch/" target="_blank"
            >pool collective</a
          >
        </li>
        <li>
          <a href="https://www.instagram.com/thick.collective/" target="_blank"
            >thick collective</a
          >
        </li>
        <li>
          <a href="https://www.instagram.com/noise.collective/" target="_blank"
            >Noise Collective</a
          >
        </li>
      </List>
      <List title="Contact">
        <li><a href="mailto:work@yanis.io" target="_blank">email</a></li>
        <li>
          <a href="https://www.instagram.com/yanisdeplazes/" target="_blank"
            >instagram</a
          >
          <li>
            <a
              href="https://signal.me/#eu/WTYbqUCFw4UvJvImlzKoe5HkyYTBJSPaBvZ8KyKYhqoAs4Ie6UlCZ70oG0Jzs2pL"
              target="_blank">signal</a
            >
          </li>
        </li>
      </List>
      <List title="Exhibitions">
        <li>
          2026 - <a
            href="https://social-footprints.com/?artist=yanis-deplazes"
            target="_blank"><b>Social Footprints: Innocence and otherwise</b></a
          >, Wanakam, Amsterdam
        </li>
        <li>
          2025 - <b>Parallel Documentary Premiere</b>, FC Hyena, Amsterdam
        </li>
        <li>
          2025 - <b>ECHO Recordings and AOS</b>, OT301, Amsterdam
        </li>
        <li>
          2025 - <b>Disconnect</b>, MA'DAM, Amsterdam
        </li>
      </List>
      <List title="Publications">
        <li>
          2026 - <b>Le Journal du Dimanche</b>,
          <a
            href="https://www.lejdd.fr/economie/taxe-emeutes-une-contribution-de-08-sur-les-assurances-dommages-des-2027-187170"
            target="_blank"
            >«Taxe émeutes» : une contribution de 0,8 % sur les assurances
            dommages dès 2027</a
          > (via Hans Lucas / AFP)
        </li>
        <li>
          2024 - <b>SRF</b>,
          <a
            href="https://www.srf.ch/news/schweiz/cybersecurity-statt-darknet-kraeftemessen-der-nachwuchshacker-in-morges"
            target="_blank">Kräftemessen der Nachwuchshacker in Morges</a
          >
        </li>
        <li>
          2024 - <b>Luzerner Zeitung</b>,
          <a
            href="https://www.luzernerzeitung.ch/zentralschweiz/uri/altdorf-ein-tag-voller-kunst-musik-und-guter-vibes-msa-dayz-gehen-in-die-zweite-runde-ld.2655098"
            target="_blank">Ein Tag voller Kunst, Musik und guter «Vibes»</a
          >
        </li>
        <li>
          2021 - <b>Urner Wochenblatt</b>,
          <a
            href="https://www.urnerwochenblatt.ch/artikel/ein-urner-rappt-ueber-sein-bewegtes-leben"
            target="_blank">Ein Urner rappt über sein bewegtes Leben</a
          >
        </li>
      </List>
      <List title="Education">
        <li>
          2026 — 2028 - <b>MA Information Design</b>, Design Academy Eindhoven
        </li>
        <li>
          2023 — 2026 - <b>BSc in Computer Science, Digital Ideation</b>,
          Lucerne University of Applied Sciences and Arts
        </li>
        <li>
          Spring 2025 - <b>Internet of Things Program Abroad Semester</b>,
          Amsterdam University of Applied Sciences
        </li>
        <li>
          2018 — 2022 - <b>Mediamatics Technician EFZ with technical FVB</b>,
          SBW NEUE MEDIEN
        </li>
      </List>
    </div>

    <div slot="details">
      {
        Image && (
          <div class="description-image">
            <ImageWrapper src={Image} alt="Yanis Deplazes" caption="Yanis" />
          </div>
        )
      }
    </div>
  </Description>
</Layout>

<style is:global>
  figure {
    cursor: default !important;
  }
</style>
