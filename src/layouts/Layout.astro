---
import Header from './Header.astro';
import Footer from './Footer.astro';
import HoverPreview from '../components/sections/HoverPreview.astro';
import { profile, site } from '../data/profile';
import { absoluteUrl } from '../utils/seo';
import DefaultShareImage from '../assets/images/default.png';

import '../styles/main.scss';

interface Props {
  /** Page name, e.g. "Archive". Leave empty on the home page. */
  title?: string;
  /** 140–160 characters work best in search results */
  description?: string;
  /** Social share image, as a URL path (e.g. thumbnail.src). Defaults to default.png */
  image?: string;
  imageAlt?: string;
  /** "article" for project pages */
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  /** Keep the page out of search engines (hidden projects) */
  noindex?: boolean;
  /** Structured data objects, see utils/seo.ts */
  schema?: object[];
}

const {
  title,
  description = profile.summary,
  image = DefaultShareImage.src,
  imageAlt = `${profile.name}, ${profile.role}`,
  type = 'website',
  published,
  modified,
  noindex = false,
  schema = [],
} = Astro.props;

// "Groundswell — Yanis Deplazes" / home: "Yanis Deplazes — Visual journalist & researcher, NL · CH"
const pageTitle = title
  ? `${title} — ${profile.name}`
  : `${profile.name} — ${profile.role}, Netherlands & Switzerland`;
const url = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="yanis.io" />
    <meta name="theme-color" content="#fafafa" />

    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/syne.woff2" as="font" type="font/woff2" crossorigin />

    {
      schema.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    <!-- Marks JavaScript as available before paint, so reveal effects never hide content without it -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip-link meta" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <HoverPreview />

    <script>
      // Fade elements with [data-reveal] in as they enter the viewport
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -10% 0px' },
      );

      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
