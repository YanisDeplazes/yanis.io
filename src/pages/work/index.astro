---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import Archive from '../../components/sections/Archive.astro';
import { breadcrumbSchema } from '../../utils/seo';
---

<Layout
  title="Archive"
  description="Every project by Yanis Deplazes: reportage, long-term photo series, event coverage, design and research, and code."
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Archive', path: '/work' },
    ]),
  ]}
>
  <PageHeader
    title="Archive"
    intro="Everything in one place: reportage, long-term series, event coverage, design and research, and the things I build with code."
  />
  <Archive />
</Layout>
