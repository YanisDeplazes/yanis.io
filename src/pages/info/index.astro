---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Wrapper from '../../layouts/Wrapper.astro';
import Portrait from '../../assets/images/portrait.jpg';
import {
  education,
  exhibitions,
  getOutlets,
  memberships,
  profile,
  socials,
} from '../../data/profile';
import { breadcrumbSchema, personSchema } from '../../utils/seo';

const { text } = profile.location;
const coverage = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(
  profile.coverage,
);
const outlets = getOutlets();

const contact = [
  { name: profile.email, href: `mailto:${profile.email}` },
  ...socials.filter(({ name }) => ['Signal'].includes(name)),
];
const external = (href: string) => !href.startsWith('mailto:');
---

<Layout
  title="Info"
  description={`Yanis Deplazes is a visual journalist and researcher working between ${text}. Information Design MA at Design Academy Eindhoven, in computer science since 2016. Member of Hans Lucas.`}
  image={Portrait.src}
  imageAlt="Portrait of Yanis Deplazes"
  type="profile"
  schema={[
    personSchema(Portrait.src),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Info', path: '/info' },
    ]),
  ]}
>
  <Wrapper>
    <div class="info">
      <figure class="portrait">
        <Image
          src={Portrait}
          alt="Portrait of Yanis Deplazes"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1000px) 33vw, 100vw"
          format="webp"
          loading="eager"
        />
      </figure>

      <div class="content">
        <h1 class="lede">
          <b>{profile.name}</b> is a visual journalist and researcher working between{
            ' '
          }
          {text}, exploring people and society through multimedia.
        </h1>

        <div class="prose bio">
          <p>
            Social movements and collective struggles across Europe are at the
            core of their work. Alongside reportage, they build experimental
            apparatus that examine social structures and everyday life.
          </p>
          <p>
            They have worked in computer science since 2016 and came to
            photography in 2020, combining analog and digital techniques since
            2023. Design ties the two together: they are currently pursuing an
            MA in Information Design at Design Academy Eindhoven, and their
            projects range from protest coverage and long-term series shot on
            film to installations, an autonomous drone and interactive websites.
          </p>
          <p>
            Photojournalist and member of <a
              href={profile.agency.href}
              target="_blank"
              rel="noopener noreferrer">{profile.agency.name}</a
            >, whose distribution network includes Reuters, AFP and dpa.
          </p>
        </div>

        <dl class="facts">
          <div class="row">
            <dt class="meta">Location</dt>
            <dd>{profile.location.label}</dd>
          </div>

          <div class="row">
            <dt class="meta">Coverage</dt>
            <dd>{coverage}, and further on request.</dd>
          </div>

          <div class="row">
            <dt class="meta">Contact</dt>
            <dd>
              <ul>
                {
                  contact.map(({ name, href }) => (
                    <li>
                      <a
                        href={href}
                        target={external(href) ? '_blank' : undefined}
                        rel="noopener noreferrer"
                      >
                        {name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>

          <div class="row">
            <dt class="meta">Published in</dt>
            <dd>
              <!-- Outlet names only. The articles sit on their project pages and on Hans Lucas. -->
              <ul class="outlets">
                {
                  outlets.map(({ outlet, count }) => (
                    <li>
                      {outlet}
                      {count > 1 && <span class="muted meta">{count}×</span>}
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>

          <div class="row">
            <dt class="meta">Exhibitions</dt>
            <dd>
              <ul class="dated">
                {
                  exhibitions.map(({ when, title, where, href }) => (
                    <li>
                      <span class="when meta">{when}</span>
                      <span class="what">
                        {href ? (
                          <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {title}
                          </a>
                        ) : (
                          title
                        )}
                      </span>
                      <span class="where">{where}</span>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>

          <div class="row">
            <dt class="meta">Education</dt>
            <dd>
              <ul class="dated">
                {
                  education.map(({ when, title, where }) => (
                    <li>
                      <span class="when meta">{when}</span>
                      <span class="what">{title}</span>
                      <span class="where">{where}</span>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>

          <div class="row">
            <dt class="meta">Member</dt>
            <dd>
              <ul>
                {
                  memberships.map(({ name, href }) => (
                    <li>
                      <a href={href} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Wrapper>
</Layout>

<style>
  .info {
    display: grid;
    gap: var(--gap-block);
    padding-top: var(--space-2xl);
  }

  .portrait :global(img) {
    width: 100%;
    background-color: var(--color-placeholder);
  }

  .lede {
    max-width: 24ch;
    font-size: clamp(1.625rem, 1rem + 2vw, 2.625rem);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede b {
    font-weight: 600;
  }

  .bio {
    margin-top: var(--gap-block);
  }

  .facts {
    max-width: 52rem;
    margin-top: var(--gap-block);
    border-bottom: 1px solid var(--color-line);
  }

  .row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--gap-inside);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-line);
  }

  dt {
    padding-top: 0.2em;
    color: var(--color-muted);
  }

  ul {
    display: grid;
    gap: 0.3em;
  }

  /* Outlets read as one line, wrapping as the list grows */
  .outlets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.25em;
  }

  .outlets li {
    display: flex;
    gap: 0.35em;
    align-items: baseline;
  }

  .tearsheets {
    margin-top: var(--space-2xs);
  }

  /* Year | what, with where on a quieter line below */
  .dated {
    gap: var(--space-s);
  }

  .dated li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    column-gap: var(--space-xs);
    align-items: baseline;
  }

  .when {
    grid-row: span 2;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .what {
    line-height: 1.35;
  }

  .where {
    grid-column: 2;
    margin-top: 0.15em;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  .muted {
    color: var(--color-muted);
  }

  dd a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 0.2s ease;
  }

  dd a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 1000px) {
    .info {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-m);
    }

    .portrait {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-height) + var(--space-m));
      align-self: start;
    }

    .content {
      grid-column: 6 / -1;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }

    .dated li {
      grid-template-columns: 1fr;
    }

    .when,
    .where {
      grid-row: auto;
      grid-column: auto;
    }
  }
</style>
